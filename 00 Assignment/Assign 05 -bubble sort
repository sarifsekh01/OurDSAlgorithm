Problem Statement : 05
Write a C program to sort an array of integers in ascending order using the Bubble Sort algorithm.


<>code:


#include <stdio.h>

int main(){
    int arr[100],n,i,j,temp;

    printf("Eneter number of element: ");
    scanf("%d", &n);

    printf("Enter the element:\n");
    for (i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }

    // Bubble Sort
    for(i=0;i<n-1;i++){
        for(j=0;j<n-1-i;j++){
            if(arr[j]>arr[j+1]){
                temp=arr[j];
                arr[j]=arr[j+1];
                arr[j+1]=temp;
            }
        }
    }

    printf("Sorted Array:\n");
    for(i=0;i<n;i++){
        printf("%d  ",arr[i]);
    }
    return 0;

}

